{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evo.example/schemas/evo-proof-credential-v2.schema.json",
  "title": "EVO Proof Credential Subject",
  "type": "object",
  "required": ["evoId", "proofType", "subjectType", "digest", "verificationUrl"],
  "properties": {
    "evoId": {"type": "string", "minLength": 8},
    "proofType": {"type": "string", "enum": ["DocumentProof", "AssetPassport", "ServiceProof"]},
    "subjectType": {"type": "string"},
    "title": {"type": "string"},
    "reference": {"type": "string"},
    "digestAlgorithm": {"type": "string", "const": "SHA-256"},
    "digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "verificationUrl": {"type": "string", "format": "uri"},
    "evidenceLevel": {
      "type": "string",
      "enum": ["EVO_CRYPTOGRAPHIC_PROOF", "EVO_ORGANIZATION_EVIDENCE", "EXTERNAL_REGULATED_TRUST"]
    }
  },
  "additionalProperties": true
}
